<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="utf-8">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background:#f0f2f5; }
    .card-app { max-width: 480px; margin: 20px auto; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,.08); }
    #resultBox { display:none; }
  </style>
</head>
<body>
  <div class="card card-app p-3">
    <h4 class="fw-bold text-center mb-3">📝 Pendaftaran Karyawan Baru</h4>

    <div id="formBox">
      <div class="mb-2">
        <label class="form-label">Nama Lengkap</label>
        <input type="text" id="namaInput" class="form-control" placeholder="Nama sesuai identitas">
      </div>
      <div class="mb-2">
        <label class="form-label">Departemen / Unit</label>
        <input type="text" id="deptInput" class="form-control" placeholder="Contoh: Rawat Inap, Laboratorium">
      </div>
      <div class="mb-2">
        <label class="form-label">Shift</label>
        <select id="shiftInput" class="form-select"></select>
      </div>
      <div class="mb-2">
        <label class="form-label">Buat PIN (min. 4 digit)</label>
        <input type="password" id="pinInput" class="form-control" inputmode="numeric" maxlength="8" placeholder="Untuk login absen nanti">
      </div>
      <div class="mb-3">
        <label class="form-label">Konfirmasi PIN</label>
        <input type="password" id="pinKonfirmasi" class="form-control" inputmode="numeric" maxlength="8" placeholder="Ulangi PIN">
      </div>
      <button class="btn btn-primary w-100" onclick="daftar()">Daftar</button>
      <div id="formMsg" class="text-danger small mt-2"></div>
      <a href="?page=absen" class="d-block text-center small mt-3 text-secondary">← Kembali ke halaman Absen</a>
    </div>

    <div id="loadingBox" style="display:none;" class="text-center py-4">
      <div class="spinner-border text-primary"></div>
      <p class="mt-2 text-muted">Mengirim pendaftaran...</p>
    </div>

    <div id="resultBox" class="text-center py-4">
      <div id="resultIcon" style="font-size:3rem;"></div>
      <h5 id="resultTitle" class="fw-bold mt-2"></h5>
      <p id="resultDetail" class="text-muted"></p>
      <a href="?page=absen" class="btn btn-primary">Ke Halaman Absen</a>
    </div>
  </div>

  <script>
    google.script.run.withSuccessHandler(function (list) {
      var sel = document.getElementById('shiftInput');
      sel.innerHTML = '';
      list.forEach(function (s) {
        var opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = s.nama;
        sel.appendChild(opt);
      });
    }).getShiftListPublic();

    function daftar() {
      var nama = document.getElementById('namaInput').value.trim();
      var dept = document.getElementById('deptInput').value.trim();
      var shiftId = document.getElementById('shiftInput').value;
      var pin = document.getElementById('pinInput').value.trim();
      var pinKonfirmasi = document.getElementById('pinKonfirmasi').value.trim();

      if (!nama || !dept || !pin || !pinKonfirmasi) {
        document.getElementById('formMsg').textContent = 'Semua kolom wajib diisi.';
        return;
      }

      document.getElementById('formBox').style.display = 'none';
      document.getElementById('loadingBox').style.display = 'block';

      google.script.run
        .withSuccessHandler(function (res) {
          document.getElementById('loadingBox').style.display = 'none';
          document.getElementById('resultBox').style.display = 'block';
          if (res.success) {
            document.getElementById('resultIcon').textContent = '✅';
            document.getElementById('resultTitle').textContent = 'Pendaftaran Terkirim';
            document.getElementById('resultDetail').innerHTML = res.message;
          } else {
            document.getElementById('resultIcon').textContent = '❌';
            document.getElementById('resultTitle').textContent = 'Pendaftaran Gagal';
            document.getElementById('resultDetail').textContent = res.message;
          }
        })
        .withFailureHandler(function (err) {
          document.getElementById('loadingBox').style.display = 'none';
          document.getElementById('formBox').style.display = 'block';
          document.getElementById('formMsg').textContent = 'Terjadi kesalahan: ' + err.message;
        })
        .registerEmployee(nama, dept, shiftId, pin, pinKonfirmasi);
    }
  </script>
</body>
</html>
