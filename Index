<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="utf-8">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background:#f0f2f5; padding-bottom: 40px; }
    .card-app { max-width: 480px; margin: 20px auto; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,.08); }
    #video, #canvas, #preview { width: 100%; border-radius: 12px; background:#000; }
    #canvas { display:none; }
    .status-box { font-size: .9rem; }
    .btn-absen { padding: 14px; font-size: 1.05rem; font-weight: 600; border-radius: 10px; }
    #resultBox { display:none; }
  </style>
</head>
<body>
  <div class="card card-app p-3">
    <div class="text-center mb-2">
      <h4 class="fw-bold mb-0">📋 Absensi Karyawan</h4>
      <small class="text-muted" id="clock">--:--:--</small>
    </div>

    <!-- FORM LOGIN ID + PIN -->
    <div id="loginBox">
      <div class="mb-2">
        <label class="form-label">ID Karyawan</label>
        <input type="text" id="idInput" class="form-control" inputmode="numeric" placeholder="Contoh: 1001">
      </div>
      <div class="mb-3">
        <label class="form-label">PIN</label>
        <input type="password" id="pinInput" class="form-control" inputmode="numeric" maxlength="8" placeholder="Masukkan PIN">
      </div>
      <button class="btn btn-primary w-100" onclick="loginKaryawan()">Login</button>
      <div id="loginMsg" class="text-danger small mt-2"></div>
      <hr>
      <p class="text-center small text-muted mb-1">Belum punya akun?</p>
      <a href="?page=daftar" class="btn btn-outline-secondary w-100">📝 Daftar Karyawan Baru</a>
    </div>

    <!-- KAMERA & GPS -->
    <div id="camBox" style="display:none;">
      <div class="alert alert-light border py-2 mb-2 small">Login sebagai: <b id="namaLogin"></b></div>
      <video id="video" autoplay playsinline></video>
      <canvas id="canvas"></canvas>
      <img id="preview" style="display:none;">

      <div class="status-box mt-2 p-2 bg-light rounded">
        <div>📍 GPS: <span id="gpsStatus">Mencari lokasi...</span></div>
        <div>🎯 Akurasi: <span id="gpsAkurasi">-</span></div>
      </div>

      <div class="d-grid gap-2 mt-3">
        <button class="btn btn-outline-secondary" id="btnAmbilFoto" onclick="ambilFoto()">📸 Ambil Foto</button>
        <button class="btn btn-outline-warning" id="btnUlangi" style="display:none;" onclick="ulangiFoto()">🔄 Ambil Ulang</button>
      </div>

      <div class="row g-2 mt-3">
        <div class="col-6">
          <button class="btn btn-success w-100 btn-absen" onclick="kirimAbsen('Masuk')" id="btnMasuk" disabled>ABSEN MASUK</button>
        </div>
        <div class="col-6">
          <button class="btn btn-danger w-100 btn-absen" onclick="kirimAbsen('Pulang')" id="btnPulang" disabled>ABSEN PULANG</button>
        </div>
      </div>
      <button class="btn btn-link w-100 mt-2 text-secondary" onclick="location.reload()">Logout / Ganti Karyawan</button>
    </div>

    <!-- HASIL -->
    <div id="resultBox" class="text-center py-4">
      <div id="resultIcon" style="font-size:3rem;"></div>
      <h5 id="resultTitle" class="fw-bold mt-2"></h5>
      <p id="resultDetail" class="text-muted"></p>
      <button class="btn btn-primary" onclick="location.reload()">Selesai</button>
    </div>

    <div id="loadingBox" style="display:none;" class="text-center py-4">
      <div class="spinner-border text-primary"></div>
      <p class="mt-2 text-muted" id="loadingText">Memproses...</p>
    </div>
  </div>

  <script>
    var currentEmp = null;
    var currentId = null, currentPin = null;
    var photoDataUrl = null;
    var currentLat = null, currentLng = null, currentAkurasi = null, currentAlamat = '';
    var stream = null;

    setInterval(function () {
      document.getElementById('clock').textContent = new Date().toLocaleTimeString('id-ID');
    }, 1000);

    function loginKaryawan() {
      currentId = document.getElementById('idInput').value.trim();
      currentPin = document.getElementById('pinInput').value.trim();
      if (!currentId || !currentPin) {
        document.getElementById('loginMsg').textContent = 'ID dan PIN wajib diisi.';
        return;
      }
      document.getElementById('loginMsg').textContent = '';
      document.getElementById('loginBox').style.display = 'none';
      document.getElementById('loadingText').textContent = 'Memeriksa login...';
      document.getElementById('loadingBox').style.display = 'block';

      google.script.run
        .withSuccessHandler(function (res) {
          document.getElementById('loadingBox').style.display = 'none';
          if (!res.success) {
            document.getElementById('loginBox').style.display = 'block';
            document.getElementById('loginMsg').textContent = res.message;
            return;
          }
          currentEmp = res;
          document.getElementById('namaLogin').textContent = res.nama + ' (' + res.departemen + ')';
          document.getElementById('camBox').style.display = 'block';
          startCamera();
          startGPS();
        })
        .withFailureHandler(function (err) {
          document.getElementById('loadingBox').style.display = 'none';
          document.getElementById('loginBox').style.display = 'block';
          document.getElementById('loginMsg').textContent = 'Terjadi kesalahan: ' + err.message;
        })
        .loginEmployee(currentId, currentPin);
    }

    function startCamera() {
      navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false })
        .then(function (s) {
          stream = s;
          document.getElementById('video').srcObject = s;
        })
        .catch(function (err) {
          alert('Tidak bisa mengakses kamera: ' + err.message);
        });
    }

    function startGPS() {
      if (!navigator.geolocation) {
        document.getElementById('gpsStatus').textContent = 'Tidak didukung perangkat ini';
        return;
      }
      navigator.geolocation.watchPosition(function (pos) {
        currentLat = pos.coords.latitude;
        currentLng = pos.coords.longitude;
        currentAkurasi = Math.round(pos.coords.accuracy);
        document.getElementById('gpsStatus').textContent = currentLat.toFixed(6) + ', ' + currentLng.toFixed(6);
        document.getElementById('gpsAkurasi').textContent = currentAkurasi + ' meter';
        reverseGeocode(currentLat, currentLng);
      }, function (err) {
        document.getElementById('gpsStatus').textContent = 'Gagal ambil lokasi (' + err.message + ')';
      }, { enableHighAccuracy: true, maximumAge: 5000, timeout: 15000 });
    }

    function reverseGeocode(lat, lng) {
      fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + lat + '&lon=' + lng)
        .then(function (r) { return r.json(); })
        .then(function (d) { currentAlamat = d.display_name || ''; })
        .catch(function () { currentAlamat = ''; });
    }

    function ambilFoto() {
      var video = document.getElementById('video');
      var canvas = document.getElementById('canvas');
      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      canvas.getContext('2d').drawImage(video, 0, 0);
      photoDataUrl = canvas.toDataURL('image/jpeg', 0.75);

      document.getElementById('preview').src = photoDataUrl;
      document.getElementById('preview').style.display = 'block';
      video.style.display = 'none';
      document.getElementById('btnAmbilFoto').style.display = 'none';
      document.getElementById('btnUlangi').style.display = 'block';
      document.getElementById('btnMasuk').disabled = false;
      document.getElementById('btnPulang').disabled = false;
    }

    function ulangiFoto() {
      photoDataUrl = null;
      document.getElementById('preview').style.display = 'none';
      document.getElementById('video').style.display = 'block';
      document.getElementById('btnAmbilFoto').style.display = 'block';
      document.getElementById('btnUlangi').style.display = 'none';
      document.getElementById('btnMasuk').disabled = true;
      document.getElementById('btnPulang').disabled = true;
    }

    function kirimAbsen(tipe) {
      if (!photoDataUrl) { alert('Ambil foto terlebih dahulu.'); return; }
      if (!currentLat) { alert('Lokasi GPS belum ditemukan, mohon tunggu sebentar.'); return; }

      document.getElementById('camBox').style.display = 'none';
      document.getElementById('loadingText').textContent = 'Mengirim data absen...';
      document.getElementById('loadingBox').style.display = 'block';
      if (stream) stream.getTracks().forEach(function (t) { t.stop(); });

      google.script.run
        .withSuccessHandler(function (res) { tampilkanHasil(res); })
        .withFailureHandler(function (err) { tampilkanHasil({ success: false, message: err.message }); })
        .saveAttendance(currentId, currentPin, tipe, photoDataUrl, currentLat, currentLng, currentAkurasi, currentAlamat);
    }

    function tampilkanHasil(res) {
      document.getElementById('loadingBox').style.display = 'none';
      document.getElementById('resultBox').style.display = 'block';
      if (res.success) {
        document.getElementById('resultIcon').textContent = res.status === 'Telat' ? '⚠️' : '✅';
        document.getElementById('resultTitle').textContent = res.message;
        document.getElementById('resultDetail').innerHTML =
          res.nama + '<br>Jam: ' + res.jam + ' &bull; Shift: ' + res.shift +
          '<br>Status: <b>' + res.status + '</b>';
      } else {
        document.getElementById('resultIcon').textContent = '❌';
        document.getElementById('resultTitle').textContent = 'Gagal';
        document.getElementById('resultDetail').textContent = res.message;
      }
    }
  </script>
</body>
</html>
